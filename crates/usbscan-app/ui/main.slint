import { LineEdit, Palette, ScrollView, Slider } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #1e1e1f : #ececec;
    out property <color> panel: dark ? #252526 : #f5f5f7;
    out property <color> card: dark ? #2c2c2e : #ffffff;
    out property <color> text: dark ? #f5f5f7 : #1c1c1e;
    out property <color> muted: dark ? #9a9fa8 : #6e6e73;
    out property <color> accent: dark ? #0a84ff : #007aff;
    out property <color> accent-pressed: dark ? #0060d2 : #0060d2;
    out property <color> border: dark ? #3a3a3c : #d9d9de;
    out property <color> separator: dark ? #38383a : #d6d6db;
    out property <color> hover: dark ? #48484a : #dcdce1;
    out property <color> control: dark ? #3a3a3c : #e8e8ed;
}

export struct PageItem {
    seq: int,
    title: string,
    thumb: image,
}

component PillButton inherits TouchArea {
    in property <string> text;
    in property <bool> primary: false;

    height: 30px;
    min-width: 64px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 7px;
        background: !root.enabled ? Theme.border : (primary ? (root.pressed ? Theme.accent-pressed : Theme.accent) : (root.has-hover ? Theme.hover : Theme.control));
        border-width: 0px;
        border-color: Theme.border;

        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.primary ? #ffffff : Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.enabled ? 1.0 : 0.5;
        }
    }
}

component IconPill inherits TouchArea {
    in property <string> glyph;
    in property <string> text;
    in property <bool> primary: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> icon-color: Theme.text;

    height: 30px;
    min-width: 78px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 7px;
        background: !root.enabled ? Theme.border : (primary ? (root.pressed ? Theme.accent-pressed : Theme.accent) : (root.has-hover ? Theme.hover : transparent));
        border-width: 0px;
        border-color: Theme.border;

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 9px;
            padding-right: 11px;
            spacing: 6px;
            alignment: center;
            if (root.has-icon) : Rectangle {
                width: 17px;
                height: 100%;
                Image {
                    width: 17px;
                    height: 17px;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    image-fit: contain;
                    colorize: root.primary ? #ffffff : root.icon-color;
                }
            }
            if (!root.has-icon) : Text {
                text: root.glyph;
                color: root.primary ? #ffffff : Theme.accent;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: root.text;
                color: root.primary ? #ffffff : Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

component Section inherits Rectangle {
    in property <string> title;
    in property <length> content-height: 0px;

    background: Theme.card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.separator;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000012;
    drop-shadow-offset-y: 1px;
    height: content-height + 46px;

    Text {
        x: 14px;
        y: 11px;
        text: root.title;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
    }
}

component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
}

component ToggleRow inherits TouchArea {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);

    height: 28px;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 10px;

        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 38px;
            height: 22px;
            border-radius: 11px;
            background: root.checked ? Theme.accent : (Theme.dark ? #39393d : #d1d1d6);
            animate background { duration: 120ms; }

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #ffffff;
                x: root.checked ? parent.width - self.width - 2px : 2px;
                y: 2px;
                drop-shadow-blur: 2px;
                drop-shadow-color: #00000033;
                drop-shadow-offset-y: 1px;
                animate x { duration: 120ms; easing: ease-out; }
            }
        }
    }
    clicked => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
}

component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    height: 30px;
    border-radius: 7px;
    background: root.enabled ? Theme.control : Theme.bg;
    border-width: 0px;
    border-color: Theme.separator;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 4px;
        Text {
            text: (root.current-index >= 0 && root.current-index < root.model.length) ? root.model[root.current-index] : "";
            color: root.enabled ? Theme.text : Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: "▾";
            color: Theme.muted;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 160px);
        height: min(root.model.length, 8) * 30px + 12px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 6px;
                spacing: 0px;
                for item[index] in root.model : Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: index == root.current-index ? (Theme.dark ? #2f3b4d : #e8f1ff) : (ta.has-hover ? Theme.hover : transparent);
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: item;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ta := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.selected(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "UsbScan";
    min-width: 1000px;
    min-height: 700px;
    background: Theme.bg;
    default-font-size: 13px;
    default-font-family: "Segoe UI Variable Text";
    init => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    in-out property <bool> dark: true;
    in property <[string]> device-options;
    in property <[string]> format-options;
    in property <[string]> fps-options: ["25 fps", "30 fps", "50 fps", "60 fps"];
    in-out property <int> device-index: 0;
    in-out property <int> format-index: 0;
    in-out property <int> fps-index: 0;
    in property <[PageItem]> pages;
    in-out property <int> selected-page: -1;
    in-out property <image> preview-source;
    in-out property <bool> has-camera: false;
    in-out property <string> status-text: "就绪";
    in-out property <string> output-dir;
    in-out property <string> file-template;
    in-out property <string> folder-template;
    in-out property <string> page-count-text: "0 页";
    in-out property <bool> auto-crop: true;
    in-out property <bool> auto-deskew: true;
    in-out property <bool> perspective: true;
    in-out property <bool> remove-shadow: false;
    in-out property <bool> white-background: false;
    in-out property <float> strength: 60;
    in-out property <bool> recording: false;
    in-out property <bool> show-rename: false;
    in-out property <string> rename-text;
    in-out property <bool> show-about: false;
    in-out property <bool> auto-check-updates: false;
    in-out property <bool> has-update: false;
    in-out property <string> update-text;
    in-out property <string> update-version;
    in-out property <bool> flash: false;
    in-out property <bool> show-toast: false;
    in-out property <string> toast-text;
    in-out property <string> version-text: "v0.1.0";

    callback capture();
    callback toggle-record();
    callback device-changed(int);
    callback format-changed(int);
    callback fps-changed(int);
    callback page-selected(int);
    callback rename-page(int);
    callback delete-page(int);
    callback rotate-page(int);
    callback mirror-page(int);
    callback auto-crop-page(int);
    callback auto-deskew-page(int);
    callback import-images();
    callback export-pdf();
    callback export-jpg();
    callback ocr-page();
    callback browse-output();
    callback apply-settings();
    callback rename-confirm(string);
    callback rename-cancel();
    callback page-menu(int);
    callback open-about();
    callback close-about();
    callback open-github();
    callback auto-check-changed(bool);
    callback install-update();
    callback refresh-devices();

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg;
        // Top command bar
        Rectangle {
            y: 0px;
            height: 56px;
            background: Theme.panel;
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                Rectangle {
                    width: 106px;
                    height: 30px;
                    border-radius: 7px;
                    background: brand-touch.has-hover ? Theme.hover : transparent;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../assets/icons/usbscan_icons/usbscan_48x48.png");
                            width: 26px;
                            height: 26px;
                            image-fit: contain;
                        }
                        Text {
                            text: "UsbScan";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    brand-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.open-about(); }
                    }
                }
                Rectangle { width: 1px; height: 20px; background: Theme.separator; }

                Text { text: "设备"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 170px;
                    model: root.device-options;
                    current-index <=> root.device-index;
                    selected(index) => { root.device-changed(index); }
                }
                Text { text: "分辨率"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 126px;
                    model: root.format-options;
                    current-index <=> root.format-index;
                    selected(index) => { root.format-changed(index); }
                }
                Text { text: "录像"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 86px;
                    model: root.fps-options;
                    current-index <=> root.fps-index;
                    selected(index) => { root.fps-changed(index); }
                }
                Rectangle { horizontal-stretch: 1; }
                IconPill {
                    icon: @image-url("../../../assets/icons/svg/refresh.svg");
                    has-icon: true;
                    text: "刷新";
                    clicked => { root.refresh-devices(); }
                }
                IconPill {
                    icon: root.recording ? @image-url("../../../assets/icons/svg/player-stop.svg") : @image-url("../../../assets/icons/svg/player-record.svg");
                    has-icon: true;
                    icon-color: #ff453a;
                    text: root.recording ? "停止" : "录像";
                    clicked => { root.toggle-record(); }
                }
                IconPill {
                    icon: @image-url("../../../assets/icons/svg/camera.svg");
                    has-icon: true;
                    text: "拍照";
                    primary: true;
                    clicked => { root.capture(); }
                }
            }
        }

        HorizontalLayout {
            y: 56px;
            height: parent.height - 80px;
            // Pages sidebar
            Rectangle {
                width: 240px;
                background: Theme.panel;
                Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.border; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "页面"; color: Theme.muted; font-size: 12px; font-weight: 600; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.page-count-text; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    }
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            spacing: 8px;
                            for page[index] in root.pages : Rectangle {
                                height: 84px;
                                border-radius: 8px;
                                background: root.selected-page == index ? Theme.accent.with-alpha(0.16) : (page-touch.has-hover ? Theme.hover : transparent);
                                border-width: 0px;
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 6px;
                                        clip: true;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: #0000001a;
                                        drop-shadow-offset-y: 1px;
                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: page.thumb;
                                            image-fit: contain;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "第 \{page.seq} 页";
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: page.title;
                                            color: Theme.muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                }
                                page-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.selected-page = index;
                                        root.page-selected(index);
                                    }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                            root.selected-page = index;
                                            root.page-selected(index);
                                            root.page-menu(index);
                                            return EventResult.accept;
                                        }
                                        EventResult.reject
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                background: Theme.dark ? #111113 : #d9d9de;
                Image {
                    source: root.preview-source;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }
                if (!root.has-camera) : Rectangle {
                    background: Theme.dark ? #111113 : #d9d9de;
                    Text {
                        text: "等待摄像头\n插上任一 USB 摄像头即可开始";
                        color: Theme.muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #ffffff;
                    opacity: root.flash ? 0.9 : 0.0;
                    animate opacity { duration: 180ms; easing: ease-out; }
                }
                if (root.show-toast) : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 58px;
                    width: 210px;
                    height: 36px;
                    border-radius: 18px;
                    background: #000000a6;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.toast-text;
                        color: #ffffff;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Settings sidebar
            Rectangle {
                width: 340px;
                background: Theme.panel;
                Rectangle { x: 0px; width: 1px; height: 100%; background: Theme.border; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Section {
                        title: "扫描设置";
                            content-height: 264px;
                            VerticalLayout {
                                padding: 12px;
                                padding-top: 34px;
                                spacing: 7px;
                                FieldLabel { text: "输出目录"; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text: root.output-dir;
                                        edited(text) => { root.output-dir = text; }
                                        horizontal-stretch: 1;
                                    }
                                    PillButton { text: "浏览…"; width: 62px; clicked => { root.browse-output(); } }
                                }
                                FieldLabel { text: "文件名模板"; }
                                LineEdit { text: root.file-template; edited(text) => { root.file-template = text; } }
                                FieldLabel { text: "子目录模板"; }
                                LineEdit { text: root.folder-template; edited(text) => { root.folder-template = text; } }
                                PillButton { text: "应用设置"; primary: true; width: 96px; clicked => { root.apply-settings(); } }
                                HorizontalLayout {
                                    spacing: 6px;
                                    PillButton { text: "导入图片"; horizontal-stretch: 1; clicked => { root.import-images(); } }
                                    PillButton { text: "导出 PDF"; horizontal-stretch: 1; clicked => { root.export-pdf(); } }
                                }
                            }
                        }

                        Section {
                            title: "图像增强";
                            content-height: 214px;
                            VerticalLayout {
                                padding: 12px;
                                padding-top: 34px;
                                spacing: 5px;
                                ToggleRow { label: "自动裁边（实时显示裁剪框）"; checked <=> root.auto-crop; }
                                ToggleRow { label: "自动纠偏"; checked <=> root.auto-deskew; }
                                ToggleRow { label: "透视校正"; checked <=> root.perspective; }
                                ToggleRow { label: "去阴影"; checked <=> root.remove-shadow; }
                                ToggleRow { label: "白底净化"; checked <=> root.white-background; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    FieldLabel { text: "强度"; width: 34px; }
                                    Slider { minimum: 0; maximum: 100; value <=> root.strength; horizontal-stretch: 1; }
                                    Text { text: root.strength; color: Theme.text; width: 28px; horizontal-alignment: right; }
                                }
                            }
                        }
                    }
                }
            }

        // Status bar
        Rectangle {
            y: parent.height - 24px;
            height: 24px;
            background: Theme.panel;
            Rectangle { y: 0px; height: 1px; width: 100%; background: Theme.border; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text { text: root.status-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: root.page-count-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Text { text: root.version-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            }
        }
    }

    // Update available banner
    if (root.has-update) : Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - 24px - self.height - 12px;
        width: 260px;
        height: 44px;
        border-radius: 10px;
        background: Theme.accent;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 3px;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.install-update(); }
        }
        Text {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            text: root.update-text;
            color: #ffffff;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Rename dialog
    if (root.show-rename) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;
        Rectangle {
            width: 430px;
            height: 150px;
            border-radius: 14px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "重命名页面"; color: Theme.text; font-size: 15px; font-weight: 600; }
                LineEdit { text: root.rename-text; edited(text) => { root.rename-text = text; } }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: "取消"; width: 72px; clicked => { root.rename-cancel(); } }
                    PillButton {
                        text: "保存";
                        primary: true;
                        width: 72px;
                        clicked => { root.rename-confirm(root.rename-text); }
                    }
                }
            }
        }
    }

    // About dialog
    if (root.show-about) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 340px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Image {
                        source: @image-url("../../../assets/icons/usbscan_icons/usbscan_64x64.png");
                        width: 56px;
                        height: 56px;
                        image-fit: contain;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "UsbScan"; color: Theme.text; font-size: 20px; font-weight: 600; }
                        Text { text: root.version-text; color: Theme.muted; font-size: 12px; }
                    }
                }
                Text {
                    text: "把任意 USB 摄像头变成文档扫描仪。拍摄、自动裁边、透视校正、离线 OCR 与 PDF 归档，全程本地完成。";
                    color: Theme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                TouchArea {
                    width: 100%;
                    height: 22px;
                    clicked => { root.open-github(); }
                    Text {
                        text: "https://github.com/Kaiyuan/usbscan";
                        color: Theme.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                ToggleRow {
                    label: "自动检查更新";
                    checked <=> root.auto-check-updates;
                    toggled(value) => { root.auto-check-changed(value); }
                }
                Text {
                    text: "勾选后每次启动会访问 GitHub Releases 检查新版本。";
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: "在 GitHub 查看"; width: 120px; clicked => { root.open-github(); } }
                    PillButton { text: "关闭"; primary: true; width: 76px; clicked => { root.close-about(); } }
                }
            }
        }
    }
}
