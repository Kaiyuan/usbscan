import { Palette, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { Icon, IconName } from "icons.slint";

export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #1e1e1f : #ececec;
    out property <color> panel: dark ? #252526 : #f5f5f7;
    out property <color> card: dark ? #2c2c2e : #ffffff;
    out property <color> text: dark ? #f5f5f7 : #1c1c1e;
    out property <color> muted: dark ? #9a9fa8 : #6e6e73;
    out property <color> accent: dark ? #0a84ff : #007aff;
    out property <color> accent-pressed: dark ? #0060d2 : #0060d2;
    out property <color> border: dark ? #3a3a3c : #d9d9de;
    out property <color> separator: dark ? #38383a : #d6d6db;
    out property <color> hover: dark ? #48484a : #dcdce1;
    out property <color> control: dark ? #3a3a3c : #e8e8ed;
}

export struct PageItem {
    seq: int,
    title: string,
    thumb: image,
}

export struct NamingVariable {
    label: string,
    token: string,
}

component PillButton inherits TouchArea {
    in property <string> text;
    in property <bool> primary: false;

    height: 30px;
    min-width: 64px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 7px;
        background: !root.enabled ? Theme.border : (primary ? (root.pressed ? Theme.accent-pressed : Theme.accent) : (root.has-hover ? Theme.hover : Theme.control));
        border-width: 0px;
        border-color: Theme.border;

        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.primary ? #ffffff : Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.enabled ? 1.0 : 0.5;
        }
    }
}

// 页面右键菜单的一行。PopupWindow 在 Linux/UOS 上承担原生菜单的职责。
component MenuEntry inherits Rectangle {
    in property <string> label;
    callback activated();

    height: 30px;
    border-radius: 5px;
    background: entry-touch.has-hover ? Theme.hover : transparent;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text: root.label;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    entry-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
}

component MenuSeparator inherits Rectangle {
    height: 9px;

    Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.separator;
    }
}

component IconPill inherits TouchArea {
    in property <string> glyph;
    in property <string> text;
    in property <bool> primary: false;
    in property <IconName> icon-name: IconName.empty;
    in property <bool> has-icon: false;
    in property <color> icon-color: Theme.text;

    height: 30px;
    min-width: 78px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 7px;
        background: !root.enabled ? Theme.border : (primary ? (root.pressed ? Theme.accent-pressed : Theme.accent) : (root.has-hover ? Theme.hover : Theme.control));
        border-width: 0px;
        border-color: Theme.border;

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 9px;
            padding-right: 11px;
            spacing: 6px;
            alignment: center;
            if (root.has-icon) : Rectangle {
                width: 17px;
                height: 100%;
                Icon {
                    icon-size: 17px;
                    y: (parent.height - self.height) / 2;
                    name: root.icon-name;
                    icon-color: root.primary ? #ffffff : root.icon-color;
                }
            }
            if (!root.has-icon) : Text {
                text: root.glyph;
                color: root.primary ? #ffffff : Theme.accent;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: root.text;
                color: root.primary ? #ffffff : Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

component Section inherits Rectangle {
    in property <string> title;
    in property <IconName> icon-name: IconName.empty;
    in property <length> content-height: 0px;

    background: Theme.card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.separator;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000012;
    drop-shadow-offset-y: 1px;
    height: content-height + 46px;

    HorizontalLayout {
        x: 14px;
        y: 9px;
        width: parent.width - 28px;
        height: 20px;
        spacing: 6px;
        Rectangle {
            width: 16px;
            height: 100%;
            Icon {
                icon-size: 16px;
                y: (parent.height - self.height) / 2;
                name: root.icon-name;
                icon-color: Theme.muted;
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component IconLabel inherits HorizontalLayout {
    in property <IconName> icon-name: IconName.empty;
    in property <string> text;
    height: 16px;
    spacing: 6px;

    Rectangle {
        width: 16px;
        height: 100%;
        Icon {
            icon-size: 14px;
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            icon-color: Theme.muted;
        }
    }
    Text {
        text: root.text;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// 输入框，圆角与按钮保持一致。
component InputField inherits Rectangle {
    in property <string> text;
    in property <bool> read-only: false;
    callback edited(string);

    height: 30px;
    border-radius: 7px;
    background: Theme.control;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: 100%;
        text: root.text;
        read-only: root.read-only;
        single-line: true;
        wrap: no-wrap;
        vertical-alignment: center;
        color: Theme.text;
        font-size: 13px;
        selection-background-color: Theme.accent;
        edited => { root.edited(input.text); }
    }
}

// 命名模板里可一键插入的变量标签。
component VariableChip inherits TouchArea {
    in property <string> label;

    height: 26px;
    min-width: 40px;
    horizontal-stretch: 1;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: root.pressed ? Theme.border : (root.has-hover ? Theme.hover : Theme.control);

        Text {
            width: 100%;
            height: 100%;
            text: root.label;
            color: Theme.text;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component ToggleRow inherits TouchArea {
    in property <string> label;
    in property <IconName> icon-name: IconName.empty;
    in-out property <bool> checked;
    callback toggled(bool);

    height: 28px;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 10px;

        Rectangle {
            width: 16px;
            height: 100%;
            Icon {
                icon-size: 16px;
                y: (parent.height - self.height) / 2;
                name: root.icon-name;
                icon-color: Theme.muted;
            }
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 38px;
            height: 22px;
            border-radius: 11px;
            background: root.checked ? Theme.accent : (Theme.dark ? #39393d : #d1d1d6);
            animate background { duration: 120ms; }

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #ffffff;
                x: root.checked ? parent.width - self.width - 2px : 2px;
                y: 2px;
                drop-shadow-blur: 2px;
                drop-shadow-color: #00000033;
                drop-shadow-offset-y: 1px;
                animate x { duration: 120ms; easing: ease-out; }
            }
        }
    }
    clicked => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
}

component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    height: 30px;
    border-radius: 7px;
    background: root.enabled ? Theme.control : Theme.bg;
    border-width: 0px;
    border-color: Theme.separator;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 4px;
        Text {
            text: (root.current-index >= 0 && root.current-index < root.model.length) ? root.model[root.current-index] : "";
            color: root.enabled ? Theme.text : Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Rectangle {
            width: 12px;
            height: 100%;
            Icon {
                icon-size: 12px;
                y: (parent.height - self.height) / 2;
                name: IconName.chevron;
                icon-color: Theme.muted;
            }
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 160px);
        height: min(root.model.length, 12) * 30px + 12px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 6px;
                spacing: 0px;
                for item[index] in root.model : Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: index == root.current-index ? (Theme.dark ? #2f3b4d : #e8f1ff) : (ta.has-hover ? Theme.hover : transparent);
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: item;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ta := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.selected(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "UsbScan";
    min-width: 1000px;
    min-height: 700px;
    background: Theme.bg;
    default-font-size: 13px;
    default-font-family: root.ui-font-family;
    init => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    in-out property <bool> dark: true;
    // 平台默认字体：Windows 用 Segoe UI Variable Text，其它平台留空交给系统字体。
    in property <string> ui-font-family: "";
    in property <[string]> device-options;
    in property <[string]> format-options;
    // 摄像头报告能力前先占位，避免下拉框空白；打开设备后由 Rust 侧覆盖。
    in property <[string]> fps-options: ["30 fps"];
    in-out property <int> device-index: 0;
    in-out property <int> format-index: 0;
    in-out property <int> fps-index: 0;
    in property <[PageItem]> pages;
    in property <[NamingVariable]> file-variables;
    in property <[NamingVariable]> folder-variables;
    in-out property <int> selected-page: -1;
    in-out property <length> pages-scroll-y: 0px;
    in-out property <image> preview-source;
    in-out property <bool> has-camera: false;
    in-out property <string> status-text: "就绪";
    in-out property <bool> update-progress-visible: false;
    in-out property <float> update-progress: 0.0;
    in-out property <string> output-dir;
    in-out property <string> file-template;
    in-out property <string> folder-template;
    in-out property <string> page-count-text: "0 页";
    in-out property <bool> auto-crop: true;
    in-out property <bool> manual-crop: false;
    in-out property <float> crop-cx: 0.5;
    in-out property <float> crop-cy: 0.5;
    in-out property <float> crop-w: 0.85;
    in-out property <float> crop-h: 0.85;
    in-out property <float> crop-angle: 0;
    // 预览画面宽高比，由 Rust 在每帧到达时更新。
    in-out property <float> preview-aspect: 1.3333;
    // 预览区域尺寸（逻辑像素），供裁剪交互换算坐标。
    out property <length> preview-w: preview-area.width;
    out property <length> preview-h: preview-area.height;
    // `image-fit: contain` 时画面在预览区域中的实际显示矩形。
    property <length> crop-img-w: min(preview-w, preview-h * root.preview-aspect);
    property <length> crop-img-h: crop-img-w / max(root.preview-aspect, 0.001);
    property <length> crop-img-x: (preview-w - crop-img-w) / 2;
    property <length> crop-img-y: (preview-h - crop-img-h) / 2;
    in-out property <bool> auto-deskew: true;
    in-out property <bool> perspective: true;
    in-out property <bool> remove-shadow: false;
    in-out property <bool> white-background: false;
    in-out property <float> strength: 60;
    in-out property <bool> recording: false;
    in-out property <string> recording-elapsed: "00:00";
    in-out property <bool> show-rename: false;
    in-out property <string> rename-text;
    in-out property <bool> show-about: false;
    in-out property <bool> auto-check-updates: true;
    in-out property <bool> has-update: false;
    in-out property <bool> update-checking: false;
    in-out property <bool> update-up-to-date: false;
    in-out property <bool> update-failed: false;
    in-out property <bool> show-update-prompt: false;
    in-out property <string> update-text;
    in-out property <string> update-version;
    in-out property <bool> flash: false;
    in-out property <bool> show-toast: false;
    in-out property <string> toast-text;
    in-out property <string> version-text: "v0.1.6";
    in property <[string]> language-options;
    in-out property <int> language-index: 0;
    // 预览画面顺时针旋转角度（0/90/180/270），由 Rust 侧维护。
    in-out property <int> rotation-degrees: 0;
    // 在 0/1 之间切换，使全屏覆盖层的透明度变化一个色阶，强制整窗重绘。
    in-out property <int> redraw-tick: 0;

    // Localized labels (set from Rust)
    in property <string> t-device: "设备";
    in property <string> t-resolution: "分辨率";
    in property <string> t-fps: "FPS";
    in property <string> t-refresh: "刷新";
    in property <string> t-record-start: "录像";
    in property <string> t-record-stop: "停止";
    in property <string> t-capture: "拍照";
    in property <string> t-rotate: "旋转";
    in property <string> t-pages: "页面";
    in property <string> t-waiting: "等待摄像头\n插上任一 USB 摄像头即可开始";
    in property <string> t-scan-settings: "扫描设置";
    in property <string> t-output-dir: "输出目录";
    in property <string> t-browse: "浏览…";
    in property <string> t-file-template: "文件名模板";
    in property <string> t-folder-template: "子目录模板";
    in property <string> t-import-images: "导入图片";
    in property <string> t-export-pdf: "导出 PDF";
    in property <string> t-enhance: "图像增强";
    in property <string> t-auto-crop: "自动裁边（实时显示裁剪框）";
    in property <string> t-auto-deskew: "自动纠偏";
    in property <string> t-perspective: "透视校正";
    in property <string> t-remove-shadow: "去阴影";
    in property <string> t-white-background: "白底净化";
    in property <string> t-strength: "强度";
    in property <string> t-rename-title: "重命名页面";
    in property <string> t-cancel: "取消";
    in property <string> t-save: "保存";
    in property <string> t-about: "把任意 USB 摄像头变成高拍仪。拍摄、自动裁边、透视校正、离线 OCR 与 PDF 归档，全程本地完成。";
    in property <string> t-auto-check: "自动检查更新";
    in property <string> t-update-hint: "勾选后每次启动会访问 GitHub Releases 检查新版本。";
    in property <string> t-check-updates: "检查更新";
    in property <string> t-checking-updates: "正在检查…";
    in property <string> t-up-to-date: "已是最新版本";
    in property <string> t-retry-check: "检查失败，点击重试";
    in property <string> t-update-title: "发现新版本";
    in property <string> t-update-now: "立即更新";
    in property <string> t-update-later: "稍后";
    in property <string> t-view-github: "在 GitHub 查看";
    in property <string> t-close: "关闭";
    in property <string> t-language: "语言";
    in property <string> t-theme: "主题";
    in property <[string]> theme-options: ["跟随系统", "浅色", "深色"];
    in-out property <int> theme-index: 0;
    in property <string> t-page-prefix: "第 ";
    in property <string> t-page-suffix: " 页";
    in property <string> t-clear-pages: "清空";
    in property <string> t-naming-hint: "点击变量即可插入模板；日期和时间取自拍摄时刻，序号自动递增。";
    in property <string> t-clean-hint: "保持画面背景干净平整，自动裁剪效果更好。";
    in property <string> t-manual-crop: "手动裁剪";
    in property <string> t-manual-crop-hint: "在预览上拖动裁剪框；拖四角改大小，拖顶部圆点旋转。";
    in property <string> t-crop-reset: "重置裁剪框";
    in property <string> t-crop-reset-angle: "还原角度";
    // 页面右键菜单：Windows 使用原生菜单，其它平台用内置弹出菜单。
    in property <bool> native-page-menu: false;
    in-out property <length> page-menu-x: 0px;
    in-out property <length> page-menu-y: 0px;
    in-out property <int> page-menu-index: -1;
    in property <string> t-menu-open: "打开";
    in property <string> t-menu-rename: "重命名";
    in property <string> t-menu-reveal: "在文件管理器中显示";
    in property <string> t-menu-auto-crop: "自动裁边";
    in property <string> t-menu-auto-deskew: "自动纠偏";
    in property <string> t-menu-ocr: "OCR 识别";
    in property <string> t-menu-export-jpg: "导出 JPG";
    in property <string> t-menu-delete: "删除";
    // OCR 结果窗口
    in-out property <bool> show-ocr-result: false;
    in-out property <string> ocr-text;
    in-out property <string> ocr-info;
    in property <string> t-ocr-title: "OCR 识别结果";
    in property <string> t-ocr-copy: "复制";
    in-out property <bool> show-tesseract-prompt: false;
    in-out property <bool> tesseract-installing: false;
    in-out property <float> tesseract-progress: 0.0;
    in property <string> tesseract-title: "未找到 Tesseract";
    in property <string> tesseract-status: "OCR 需要 Tesseract。是否现在从 GitHub 下载并安装？安装可能需要管理员权限，完成后会自动继续识别。";
    in property <string> tesseract-install-label: "下载并安装";

    callback capture();
    callback toggle-record();
    callback rotate-preview();
    callback device-changed(int);
    callback format-changed(int);
    callback fps-changed(int);
    callback page-selected(int);
    callback clear-pages();
    callback open-page(int);
    callback rename-page(int);
    callback delete-page(int);
    callback rotate-page(int);
    callback mirror-page(int);
    callback auto-crop-page(int);
    callback auto-deskew-page(int);
    callback import-images();
    callback export-pdf();
    callback export-jpg();
    callback ocr-page();
    callback browse-output();
    callback rename-confirm(string);
    callback rename-cancel();
    callback page-menu(int);
    callback page-menu-command(int, int);
    callback crop-pointer-down(length, length);
    callback crop-pointer-move(length, length);
    callback crop-pointer-up();
    callback crop-reset-rect();
    callback crop-reset-angle();
    callback open-about();
    callback close-about();
    callback open-github();
    callback auto-check-changed(bool);
    callback check-updates();
    callback install-update();
    callback refresh-devices();
    callback language-changed(int);
    callback theme-changed(int);
    callback install-tesseract();
    callback cancel-tesseract();
    callback copy-ocr-text();
    callback close-ocr-result();

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg;
        // Top command bar
        Rectangle {
            y: 0px;
            height: 56px;
            background: Theme.panel;
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                Rectangle {
                    width: 106px;
                    height: 30px;
                    border-radius: 7px;
                    background: brand-touch.has-hover ? Theme.hover : transparent;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../assets/icons/usbscan_icons/usbscan_48x48.png");
                            width: 26px;
                            height: 26px;
                            image-fit: contain;
                        }
                        Text {
                            text: "UsbScan";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    brand-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.open-about(); }
                    }
                }
                Rectangle { width: 1px; height: 20px; background: Theme.separator; }

                Text { text: root.t-device; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 150px;
                    model: root.device-options;
                    current-index <=> root.device-index;
                    selected(index) => { root.device-changed(index); }
                }
                Text { text: root.t-resolution; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 112px;
                    model: root.format-options;
                    current-index <=> root.format-index;
                    selected(index) => { root.format-changed(index); }
                }
                Text { text: root.t-fps; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 78px;
                    model: root.fps-options;
                    current-index <=> root.fps-index;
                    selected(index) => { root.fps-changed(index); }
                }
                Rectangle { horizontal-stretch: 1; }
                IconPill {
                    icon-name: IconName.rotate;
                    has-icon: true;
                    text: root.rotation-degrees == 0 ? root.t-rotate : root.t-rotate + " \{root.rotation-degrees}°";
                    clicked => { root.rotate-preview(); }
                }
                IconPill {
                    icon-name: IconName.refresh;
                    has-icon: true;
                    text: root.t-refresh;
                    clicked => { root.refresh-devices(); }
                }
                IconPill {
                    icon-name: root.recording ? IconName.stop : IconName.video;
                    has-icon: true;
                    icon-color: root.recording ? #ff453a : Theme.text;
                    text: root.recording ? root.t-record-stop : root.t-record-start;
                    clicked => { root.toggle-record(); }
                }
                IconPill {
                    icon-name: IconName.camera;
                    has-icon: true;
                    text: root.t-capture;
                    primary: true;
                    clicked => { root.capture(); }
                }
            }
        }

        HorizontalLayout {
            y: 56px;
            height: parent.height - 80px;
            // Pages sidebar
            Rectangle {
                width: 240px;
                background: Theme.panel;
                Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.border; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.t-pages; color: Theme.muted; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.page-count-text; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                        PillButton {
                            text: root.t-clear-pages;
                            height: 22px;
                            min-width: 44px;
                            enabled: root.pages.length > 0;
                            clicked => { root.clear-pages(); }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        content-y <=> root.pages-scroll-y;
                        VerticalLayout {
                            spacing: 8px;
                            for page[index] in root.pages : Rectangle {
                                height: 84px;
                                border-radius: 8px;
                                background: root.selected-page == index ? Theme.accent.with-alpha(0.16) : (page-touch.has-hover ? Theme.hover : transparent);
                                border-width: 0px;
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 6px;
                                        clip: true;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: #0000001a;
                                        drop-shadow-offset-y: 1px;
                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: page.thumb;
                                            image-fit: contain;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: root.t-page-prefix + "\{page.seq}" + root.t-page-suffix;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: page.title;
                                            color: Theme.muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                }
                                page-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    double-clicked => {
                                        root.selected-page = index;
                                        root.page-selected(index);
                                        root.open-page(index);
                                    }
                                    clicked => {
                                        root.selected-page = index;
                                        root.page-selected(index);
                                    }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                            root.selected-page = index;
                                            root.page-selected(index);
                                            if (root.native-page-menu) {
                                                root.page-menu(index);
                                            } else {
                                                // 菜单宽 200、高 279；贴近窗口边缘时翻到鼠标左侧/上方，
                                                // 避免被窗口裁掉（winit 后端把弹窗画在主窗口内）。
                                                root.page-menu-x = page-touch.absolute-position.x + page-touch.mouse-x + 208px <= root.width
                                                    ? page-touch.absolute-position.x + page-touch.mouse-x
                                                    : max(0px, page-touch.absolute-position.x + page-touch.mouse-x - 200px);
                                                root.page-menu-y = page-touch.absolute-position.y + page-touch.mouse-y + 287px <= root.height
                                                    ? page-touch.absolute-position.y + page-touch.mouse-y
                                                    : max(0px, page-touch.absolute-position.y + page-touch.mouse-y - 279px);
                                                root.page-menu-index = index;
                                                page-menu-popup.show();
                                            }
                                            return EventResult.accept;
                                        }
                                        EventResult.reject
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.separator; }
                    HorizontalLayout {
                        spacing: 8px;
                        PillButton {
                            text: root.t-import-images;
                            horizontal-stretch: 1;
                            clicked => { root.import-images(); }
                        }
                        PillButton {
                            text: root.t-export-pdf;
                            horizontal-stretch: 1;
                            clicked => { root.export-pdf(); }
                        }
                    }
                }
            }
            preview-area := Rectangle {
                background: Theme.dark ? #111113 : #d9d9de;
                Image {
                    source: root.preview-source;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }
                if (!root.has-camera) : Rectangle {
                    background: Theme.dark ? #111113 : #d9d9de;
                    Text {
                        text: root.t-waiting;
                        color: Theme.muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #ffffff;
                    opacity: root.flash ? 0.9 : 0.0;
                    animate opacity { duration: 180ms; easing: ease-out; }
                }
                // 手动裁剪：全屏交互层 + 可旋转的裁剪框。
                if (root.manual-crop && root.has-camera) : Rectangle {
                    crop-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.crop-pointer-down(crop-touch.mouse-x, crop-touch.mouse-y);
                                return EventResult.accept;
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.crop-pointer-up();
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                        moved => {
                            root.crop-pointer-move(crop-touch.mouse-x, crop-touch.mouse-y);
                        }
                    }

                    crop-box := Rectangle {
                        x: root.crop-img-x + (root.crop-cx - root.crop-w / 2) * root.crop-img-w;
                        y: root.crop-img-y + (root.crop-cy - root.crop-h / 2) * root.crop-img-h;
                        width: root.crop-w * root.crop-img-w;
                        height: root.crop-h * root.crop-img-h;
                        border-width: 2px;
                        border-color: Theme.accent;
                        background: transparent;
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-rotation: root.crop-angle * 1deg;

                        // 三分参考线
                        Rectangle { x: parent.width / 3; width: 1px; height: 100%; background: #ffffff80; }
                        Rectangle { x: parent.width * 2 / 3; width: 1px; height: 100%; background: #ffffff80; }
                        Rectangle { y: parent.height / 3; width: 100%; height: 1px; background: #ffffff80; }
                        Rectangle { y: parent.height * 2 / 3; width: 100%; height: 1px; background: #ffffff80; }

                        // 四角缩放点
                        Rectangle { x: -6px; y: -6px; width: 12px; height: 12px; border-radius: 3px; background: #ffffff; border-width: 2px; border-color: Theme.accent; }
                        Rectangle { x: parent.width - 6px; y: -6px; width: 12px; height: 12px; border-radius: 3px; background: #ffffff; border-width: 2px; border-color: Theme.accent; }
                        Rectangle { x: parent.width - 6px; y: parent.height - 6px; width: 12px; height: 12px; border-radius: 3px; background: #ffffff; border-width: 2px; border-color: Theme.accent; }
                        Rectangle { x: -6px; y: parent.height - 6px; width: 12px; height: 12px; border-radius: 3px; background: #ffffff; border-width: 2px; border-color: Theme.accent; }

                        // 顶部旋转手柄
                        Rectangle { x: parent.width / 2 - 1px; y: -19px; width: 2px; height: 19px; background: Theme.accent; }
                        Rectangle { x: parent.width / 2 - 6px; y: -31px; width: 12px; height: 12px; border-radius: 6px; background: #ffffff; border-width: 2px; border-color: Theme.accent; }
                        Text {
                            y: -52px;
                            width: 100%;
                            text: "\{round(root.crop-angle)}°";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }

                    // 手动裁剪工具栏
                    Rectangle {
                        x: root.crop-img-x + 8px;
                        y: root.crop-img-y + 8px;
                        width: 320px;
                        height: 34px;
                        background: #00000099;
                        border-radius: 9px;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 6px;
                            PillButton {
                                text: root.t-crop-reset;
                                height: 26px;
                                min-width: 88px;
                                clicked => { root.crop-reset-rect(); }
                            }
                            PillButton {
                                text: root.t-crop-reset-angle;
                                height: 26px;
                                min-width: 88px;
                                clicked => { root.crop-reset-angle(); }
                            }
                            Text {
                                text: "\{round(root.crop-angle)}°";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                if (root.show-toast) : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 58px - (root.recording ? 42px : 0px);
                    width: 360px;
                    height: 36px;
                    border-radius: 18px;
                    background: #0000008c;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.toast-text;
                        color: #ffffff;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // 录像计时：固定显示在预览窗口底部中央。
                if (root.recording) : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 16px;
                    width: 108px;
                    height: 32px;
                    border-radius: 16px;
                    background: #00000099;
                    border-width: 1px;
                    border-color: #ffffff33;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;
                        // 交叉轴居中可以避免红点被拉成竖条，并让圆点与时间文字对齐。
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: #ff453a;
                        }
                        Text {
                            text: root.recording-elapsed;
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Settings sidebar
            Rectangle {
                width: 340px;
                background: Theme.panel;
                Rectangle { x: 0px; width: 1px; height: 100%; background: Theme.border; }
                ScrollView {
                    width: 100%;
                    height: 100%;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: 100%;
                        padding: 12px;
                        spacing: 10px;

                        Section {
                            title: root.t-scan-settings;
                            icon-name: IconName.settings;
                            content-height: 306px;
                            VerticalLayout {
                                padding: 12px;
                                padding-top: 34px;
                                spacing: 7px;
                                IconLabel { text: root.t-output-dir; icon-name: IconName.folder; horizontal-stretch: 1; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    InputField {
                                        text: root.output-dir;
                                        edited(text) => { root.output-dir = text; }
                                        horizontal-stretch: 1;
                                    }
                                    PillButton { text: root.t-browse; width: 96px; clicked => { root.browse-output(); } }
                                }
                                IconLabel { text: root.t-file-template; icon-name: IconName.file-text; horizontal-stretch: 1; }
                                InputField { text: root.file-template; edited(text) => { root.file-template = text; } }
                                HorizontalLayout {
                                    spacing: 6px;
                                    for variable in root.file-variables : VariableChip {
                                        label: variable.label;
                                        clicked => { root.file-template = root.file-template + variable.token; }
                                    }
                                }
                                IconLabel { text: root.t-folder-template; icon-name: IconName.folders; horizontal-stretch: 1; }
                                InputField { text: root.folder-template; edited(text) => { root.folder-template = text; } }
                                HorizontalLayout {
                                    spacing: 6px;
                                    for variable in root.folder-variables : VariableChip {
                                        label: variable.label;
                                        clicked => { root.folder-template = root.folder-template + variable.token; }
                                    }
                                }
                                Text {
                                    text: root.t-naming-hint;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Section {
                            title: root.t-enhance;
                            icon-name: IconName.wand;
                            // 6 × 28px 开关 + 2 × 30px 提示 + 24px 强度行 + 间距
                            content-height: 288px;
                            VerticalLayout {
                                padding: 12px;
                                padding-top: 34px;
                                spacing: 5px;
                                ToggleRow { label: root.t-auto-crop; icon-name: IconName.crop; checked <=> root.auto-crop; }
                                Text {
                                    text: root.t-clean-hint;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    height: 30px;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                                ToggleRow { label: root.t-manual-crop; icon-name: IconName.crop; checked <=> root.manual-crop; }
                                Text {
                                    text: root.t-manual-crop-hint;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    height: 30px;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                                ToggleRow { label: root.t-auto-deskew; icon-name: IconName.rotate; checked <=> root.auto-deskew; }
                                ToggleRow { label: root.t-perspective; icon-name: IconName.perspective; checked <=> root.perspective; }
                                ToggleRow { label: root.t-remove-shadow; icon-name: IconName.shadow-off; checked <=> root.remove-shadow; }
                                ToggleRow { label: root.t-white-background; icon-name: IconName.contrast; checked <=> root.white-background; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 24px;
                                    // 交叉轴对齐让标签和数值都按自身高度垂直居中在滑块中线上。
                                    cross-axis-alignment: center;
                                    IconLabel { text: root.t-strength; icon-name: IconName.adjust; width: 72px; }
                                    Slider { minimum: 0; maximum: 100; value <=> root.strength; horizontal-stretch: 1; }
                                    Text { text: root.strength; color: Theme.text; width: 28px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Status bar
        Rectangle {
            y: parent.height - 24px;
            height: 24px;
            background: Theme.panel;
            Rectangle { y: 0px; height: 1px; width: 100%; background: Theme.border; }
            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                width: 100%;
                background: transparent;
                visible: root.update-progress-visible;

                Rectangle {
                    width: parent.width * root.update-progress;
                    height: 100%;
                    background: Theme.accent;
                    animate width { duration: 120ms; }
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text { text: root.status-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: root.page-count-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Rectangle {
                    width: root.has-update ? 72px : 46px;
                    height: 100%;
                    border-radius: 4px;
                    background: root.has-update && update-badge-touch.has-hover ? Theme.hover : transparent;

                    HorizontalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        spacing: 4px;
                        alignment: center;
                        Text {
                            text: root.version-text;
                            color: root.has-update ? Theme.text : Theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        if (root.has-update) : Rectangle {
                            width: 14px;
                            height: 14px;
                            Icon {
                                icon-size: 14px;
                                name: IconName.alert;
                                icon-color: #f5b800;
                            }
                        }
                    }
                    update-badge-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: root.has-update;
                        mouse-cursor: pointer;
                        clicked => { root.show-update-prompt = true; }
                    }
                }
            }
        }
    }

    // Update prompt: shown only after the user clicks the version badge.
    if (root.show-update-prompt && root.has-update) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.show-update-prompt = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 470px;
            height: 220px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        Icon {
                            icon-size: 24px;
                            name: IconName.alert;
                            icon-color: #f5b800;
                        }
                    }
                    Text {
                        text: root.t-update-title + " " + root.update-version;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: root.update-text;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton {
                        text: root.t-update-later;
                        width: 90px;
                        clicked => { root.show-update-prompt = false; }
                    }
                    PillButton {
                        text: root.t-update-now;
                        primary: true;
                        width: 120px;
                        clicked => {
                            root.show-update-prompt = false;
                            root.install-update();
                        }
                    }
                }
            }
        }
    }

    // Rename dialog
    if (root.show-rename) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;
        Rectangle {
            width: 430px;
            height: 150px;
            border-radius: 14px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: root.t-rename-title; color: Theme.text; font-size: 15px; font-weight: 600; }
                InputField { text: root.rename-text; edited(text) => { root.rename-text = text; } }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: root.t-cancel; width: 80px; clicked => { root.rename-cancel(); } }
                    PillButton {
                        text: root.t-save;
                        primary: true;
                        width: 90px;
                        clicked => { root.rename-confirm(root.rename-text); }
                    }
                }
            }
        }
    }

    // OCR result dialog: shows the recognized text so the user can copy it.
    if (root.show-ocr-result) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;

        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 640px;
            height: 480px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: root.t-ocr-title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: root.ocr-info;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                ocr-editor := TextEdit {
                    text: root.ocr-text;
                    read-only: true;
                    wrap: word-wrap;
                    font-size: 13px;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton {
                        text: root.t-ocr-copy;
                        width: 96px;
                        clicked => {
                            // Slint 自带的剪贴板在 Windows/macOS/Linux 都可用；
                            // Rust 侧的 Win32 写入用于再兜底并给出状态反馈。
                            ocr-editor.select-all();
                            ocr-editor.copy();
                            root.copy-ocr-text();
                        }
                    }
                    PillButton {
                        text: root.t-close;
                        primary: true;
                        width: 96px;
                        clicked => { root.close-ocr-result(); }
                    }
                }
            }
        }
    }

    // Tesseract installation prompt
    if (root.show-tesseract-prompt) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;

        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: 278px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: root.tesseract-title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: root.tesseract-status;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                if (root.tesseract-installing) : Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.control;

                    Rectangle {
                        width: parent.width * root.tesseract-progress;
                        height: 100%;
                        border-radius: 3px;
                        background: Theme.accent;
                        animate width { duration: 120ms; }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton {
                        text: root.tesseract-install-label;
                        primary: true;
                        width: 170px;
                        enabled: !root.tesseract-installing;
                        clicked => { root.install-tesseract(); }
                    }
                    PillButton {
                        text: root.t-cancel;
                        width: 90px;
                        clicked => { root.cancel-tesseract(); }
                    }
                }
            }
        }
    }

    // About dialog
    if (root.show-about) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 500px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Image {
                        source: @image-url("../../../assets/icons/usbscan_icons/usbscan_64x64.png");
                        width: 56px;
                        height: 56px;
                        image-fit: contain;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "UsbScan"; color: Theme.text; font-size: 20px; font-weight: 600; }
                        Text { text: root.version-text; color: Theme.muted; font-size: 12px; }
                    }
                }
                Text {
                    text: root.t-about;
                    color: Theme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                TouchArea {
                    width: 100%;
                    height: 22px;
                    clicked => { root.open-github(); }
                    Text {
                        text: "https://github.com/Kaiyuan/usbscan";
                        color: Theme.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    spacing: 12px;
                    // 左侧：界面语言
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.t-language;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Dropdown {
                            width: 132px;
                            model: root.language-options;
                            current-index <=> root.language-index;
                            selected(index) => { root.language-changed(index); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // 右侧：主题模式
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.t-theme;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Dropdown {
                            width: 124px;
                            model: root.theme-options;
                            current-index <=> root.theme-index;
                            selected(index) => { root.theme-changed(index); }
                        }
                    }
                }
                Rectangle { height: 8px; }
                ToggleRow {
                    label: root.t-auto-check;
                    checked <=> root.auto-check-updates;
                    toggled(value) => { root.auto-check-changed(value); }
                }
                Text {
                    text: root.t-update-hint;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton {
                        text: root.update-checking ? root.t-checking-updates
                            : root.has-update ? (root.t-update-title + " " + root.update-version)
                            : root.update-up-to-date ? root.t-up-to-date
                            : root.update-failed ? root.t-retry-check
                            : root.t-check-updates;
                        enabled: !root.update-checking;
                        width: 172px;
                        clicked => {
                            if (root.has-update) {
                                root.show-about = false;
                                root.show-update-prompt = true;
                            } else {
                                root.check-updates();
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PillButton { text: root.t-view-github; width: 132px; clicked => { root.open-github(); } }
                    PillButton { text: root.t-close; primary: true; width: 80px; clicked => { root.close-about(); } }
                }
            }
        }
    }

    // 几乎不可见的全屏覆盖层：切换颜色会让软件渲染器重绘整个窗口，
    // 避免 Windows 长时间最小化后恢复时只重绘局部区域而留下白屏。
    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, root.redraw-tick / 255.0);
    }

    // 页面右键菜单。Windows 走原生菜单（native-page-menu），
    // Linux/UOS 与 macOS 用这个内置菜单。
    page-menu-popup := PopupWindow {
        x: root.page-menu-x;
        y: root.page-menu-y;
        width: 200px;
        height: 6px + 6px + 8 * 30px + 3 * 9px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 6px;
                spacing: 0px;

                MenuEntry {
                    label: root.t-menu-open;
                    activated => { page-menu-popup.close(); root.page-menu-command(1, root.page-menu-index); }
                }
                MenuEntry {
                    label: root.t-menu-rename;
                    activated => { page-menu-popup.close(); root.page-menu-command(2, root.page-menu-index); }
                }
                MenuEntry {
                    label: root.t-menu-reveal;
                    activated => { page-menu-popup.close(); root.page-menu-command(3, root.page-menu-index); }
                }
                MenuSeparator { }
                MenuEntry {
                    label: root.t-menu-auto-crop;
                    activated => { page-menu-popup.close(); root.page-menu-command(4, root.page-menu-index); }
                }
                MenuEntry {
                    label: root.t-menu-auto-deskew;
                    activated => { page-menu-popup.close(); root.page-menu-command(5, root.page-menu-index); }
                }
                MenuSeparator { }
                MenuEntry {
                    label: root.t-menu-ocr;
                    activated => { page-menu-popup.close(); root.page-menu-command(6, root.page-menu-index); }
                }
                MenuEntry {
                    label: root.t-menu-export-jpg;
                    activated => { page-menu-popup.close(); root.page-menu-command(7, root.page-menu-index); }
                }
                MenuSeparator { }
                MenuEntry {
                    label: root.t-menu-delete;
                    activated => { page-menu-popup.close(); root.page-menu-command(8, root.page-menu-index); }
                }
            }
        }
    }
}
