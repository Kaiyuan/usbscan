# 统一换行符，避免 Windows/macOS/Linux 协作时产生整文件 diff。
* text=auto

*.rs      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
*.gif     binary
*.zip     binary
