import { LineEdit, Palette, ScrollView, Slider } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #1e1e1f : #ececec;
    out property <color> panel: dark ? #252526 : #f5f5f7;
    out property <color> card: dark ? #2c2c2e : #ffffff;
    out property <color> text: dark ? #f5f5f7 : #1c1c1e;
    out property <color> muted: dark ? #9a9fa8 : #6e6e73;
    out property <color> accent: dark ? #0a84ff : #007aff;
    out property <color> accent-pressed: dark ? #0060d2 : #0060d2;
    out property <color> border: dark ? #3a3a3c : #d9d9de;
    out property <color> separator: dark ? #38383a : #d6d6db;
    out property <color> hover: dark ? #48484a : #dcdce1;
    out property <color> control: dark ? #3a3a3c : #e8e8ed;
}

export struct PageItem {
    seq: int,
    title: string,
    thumb: image,
}

component PillButton inherits TouchArea {
    in property <string> text;
    in property <bool> primary: false;

    height: 30px;
    min-width: 64px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 7px;
        background: !root.enabled ? Theme.border : (primary ? (root.pressed ? Theme.accent-pressed : Theme.accent) : (root.has-hover ? Theme.hover : Theme.control));
        border-width: 0px;
        border-color: Theme.border;

        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.primary ? #ffffff : Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.enabled ? 1.0 : 0.5;
        }
    }
}

component IconPill inherits TouchArea {
    in property <string> glyph;
    in property <string> text;
    in property <bool> primary: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> icon-color: Theme.text;

    height: 30px;
    min-width: 78px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 7px;
        background: !root.enabled ? Theme.border : (primary ? (root.pressed ? Theme.accent-pressed : Theme.accent) : (root.has-hover ? Theme.hover : Theme.control));
        border-width: 0px;
        border-color: Theme.border;

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 9px;
            padding-right: 11px;
            spacing: 6px;
            alignment: center;
            if (root.has-icon) : Rectangle {
                width: 17px;
                height: 100%;
                Image {
                    width: 17px;
                    height: 17px;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    image-fit: contain;
                    colorize: root.primary ? #ffffff : root.icon-color;
                }
            }
            if (!root.has-icon) : Text {
                text: root.glyph;
                color: root.primary ? #ffffff : Theme.accent;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: root.text;
                color: root.primary ? #ffffff : Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

component Section inherits Rectangle {
    in property <string> title;
    in property <length> content-height: 0px;

    background: Theme.card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.separator;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000012;
    drop-shadow-offset-y: 1px;
    height: content-height + 46px;

    Text {
        x: 14px;
        y: 11px;
        text: root.title;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
    }
}

component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
}

component ToggleRow inherits TouchArea {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);

    height: 28px;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 10px;

        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 38px;
            height: 22px;
            border-radius: 11px;
            background: root.checked ? Theme.accent : (Theme.dark ? #39393d : #d1d1d6);
            animate background { duration: 120ms; }

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #ffffff;
                x: root.checked ? parent.width - self.width - 2px : 2px;
                y: 2px;
                drop-shadow-blur: 2px;
                drop-shadow-color: #00000033;
                drop-shadow-offset-y: 1px;
                animate x { duration: 120ms; easing: ease-out; }
            }
        }
    }
    clicked => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
}

component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    height: 30px;
    border-radius: 7px;
    background: root.enabled ? Theme.control : Theme.bg;
    border-width: 0px;
    border-color: Theme.separator;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 4px;
        Text {
            text: (root.current-index >= 0 && root.current-index < root.model.length) ? root.model[root.current-index] : "";
            color: root.enabled ? Theme.text : Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: "▾";
            color: Theme.muted;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 160px);
        height: min(root.model.length, 12) * 30px + 12px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 6px;
                spacing: 0px;
                for item[index] in root.model : Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: index == root.current-index ? (Theme.dark ? #2f3b4d : #e8f1ff) : (ta.has-hover ? Theme.hover : transparent);
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: item;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ta := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.selected(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "UsbScan";
    min-width: 1000px;
    min-height: 700px;
    background: Theme.bg;
    default-font-size: 13px;
    default-font-family: "Segoe UI Variable Text";
    init => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    in-out property <bool> dark: true;
    in property <[string]> device-options;
    in property <[string]> format-options;
    in property <[string]> fps-options: ["25 fps", "30 fps", "50 fps", "60 fps"];
    in-out property <int> device-index: 0;
    in-out property <int> format-index: 0;
    in-out property <int> fps-index: 0;
    in property <[PageItem]> pages;
    in-out property <int> selected-page: -1;
    in-out property <image> preview-source;
    in-out property <bool> has-camera: false;
    in-out property <string> status-text: "就绪";
    in-out property <string> output-dir;
    in-out property <string> file-template;
    in-out property <string> folder-template;
    in-out property <string> page-count-text: "0 页";
    in-out property <bool> auto-crop: true;
    in-out property <bool> auto-deskew: true;
    in-out property <bool> perspective: true;
    in-out property <bool> remove-shadow: false;
    in-out property <bool> white-background: false;
    in-out property <float> strength: 60;
    in-out property <bool> recording: false;
    in-out property <bool> show-rename: false;
    in-out property <string> rename-text;
    in-out property <bool> show-about: false;
    in-out property <bool> auto-check-updates: true;
    in-out property <bool> has-update: false;
    in-out property <bool> update-checking: false;
    in-out property <bool> show-update-prompt: false;
    in-out property <string> update-text;
    in-out property <string> update-version;
    in-out property <bool> flash: false;
    in-out property <bool> show-toast: false;
    in-out property <string> toast-text;
    in-out property <string> version-text: "v0.1.1";
    in property <[string]> language-options;
    in-out property <int> language-index: 0;
    // 预览画面顺时针旋转角度（0/90/180/270），由 Rust 侧维护。
    in-out property <int> rotation-degrees: 0;
    // 在 0/1 之间切换，使全屏覆盖层的透明度变化一个色阶，强制整窗重绘。
    in-out property <int> redraw-tick: 0;

    // Localized labels (set from Rust)
    in property <string> t-device: "设备";
    in property <string> t-resolution: "分辨率";
    in property <string> t-fps: "FPS";
    in property <string> t-refresh: "刷新";
    in property <string> t-record-start: "录像";
    in property <string> t-record-stop: "停止";
    in property <string> t-capture: "拍照";
    in property <string> t-rotate: "旋转";
    in property <string> t-pages: "页面";
    in property <string> t-waiting: "等待摄像头\n插上任一 USB 摄像头即可开始";
    in property <string> t-scan-settings: "扫描设置";
    in property <string> t-output-dir: "输出目录";
    in property <string> t-browse: "浏览…";
    in property <string> t-file-template: "文件名模板";
    in property <string> t-folder-template: "子目录模板";
    in property <string> t-apply-settings: "应用设置";
    in property <string> t-import-images: "导入图片";
    in property <string> t-export-pdf: "导出 PDF";
    in property <string> t-enhance: "图像增强";
    in property <string> t-auto-crop: "自动裁边（实时显示裁剪框）";
    in property <string> t-auto-deskew: "自动纠偏";
    in property <string> t-perspective: "透视校正";
    in property <string> t-remove-shadow: "去阴影";
    in property <string> t-white-background: "白底净化";
    in property <string> t-strength: "强度";
    in property <string> t-rename-title: "重命名页面";
    in property <string> t-cancel: "取消";
    in property <string> t-save: "保存";
    in property <string> t-about: "把任意 USB 摄像头变成文档扫描仪。拍摄、自动裁边、透视校正、离线 OCR 与 PDF 归档，全程本地完成。";
    in property <string> t-auto-check: "自动检查更新";
    in property <string> t-update-hint: "勾选后每次启动会访问 GitHub Releases 检查新版本。";
    in property <string> t-check-updates: "检查更新";
    in property <string> t-checking-updates: "正在检查…";
    in property <string> t-update-title: "发现新版本";
    in property <string> t-update-now: "立即更新";
    in property <string> t-update-later: "稍后";
    in property <string> t-view-github: "在 GitHub 查看";
    in property <string> t-close: "关闭";
    in property <string> t-language: "语言";
    in property <string> t-page-prefix: "第 ";
    in property <string> t-page-suffix: " 页";
    in-out property <bool> show-tesseract-prompt: false;
    in-out property <bool> tesseract-installing: false;
    in property <string> tesseract-title: "未找到 Tesseract";
    in property <string> tesseract-status: "OCR 需要 Tesseract。是否现在从 GitHub 下载并安装？安装可能需要管理员权限，完成后会自动继续识别。";
    in property <string> tesseract-install-label: "下载并安装";

    callback capture();
    callback toggle-record();
    callback rotate-preview();
    callback device-changed(int);
    callback format-changed(int);
    callback fps-changed(int);
    callback page-selected(int);
    callback open-page(int);
    callback rename-page(int);
    callback delete-page(int);
    callback rotate-page(int);
    callback mirror-page(int);
    callback auto-crop-page(int);
    callback auto-deskew-page(int);
    callback import-images();
    callback export-pdf();
    callback export-jpg();
    callback ocr-page();
    callback browse-output();
    callback apply-settings();
    callback rename-confirm(string);
    callback rename-cancel();
    callback page-menu(int);
    callback open-about();
    callback close-about();
    callback open-github();
    callback auto-check-changed(bool);
    callback check-updates();
    callback install-update();
    callback refresh-devices();
    callback language-changed(int);
    callback install-tesseract();
    callback cancel-tesseract();

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg;
        // Top command bar
        Rectangle {
            y: 0px;
            height: 56px;
            background: Theme.panel;
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                Rectangle {
                    width: 106px;
                    height: 30px;
                    border-radius: 7px;
                    background: brand-touch.has-hover ? Theme.hover : transparent;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../../../assets/icons/usbscan_icons/usbscan_48x48.png");
                            width: 26px;
                            height: 26px;
                            image-fit: contain;
                        }
                        Text {
                            text: "UsbScan";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    brand-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.open-about(); }
                    }
                }
                Rectangle { width: 1px; height: 20px; background: Theme.separator; }

                Text { text: root.t-device; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 150px;
                    model: root.device-options;
                    current-index <=> root.device-index;
                    selected(index) => { root.device-changed(index); }
                }
                Text { text: root.t-resolution; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 112px;
                    model: root.format-options;
                    current-index <=> root.format-index;
                    selected(index) => { root.format-changed(index); }
                }
                Text { text: root.t-fps; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Dropdown {
                    width: 78px;
                    model: root.fps-options;
                    current-index <=> root.fps-index;
                    selected(index) => { root.fps-changed(index); }
                }
                Rectangle { horizontal-stretch: 1; }
                IconPill {
                    icon: @image-url("../../../assets/icons/svg/rotate-clockwise.svg");
                    has-icon: true;
                    text: root.rotation-degrees == 0 ? root.t-rotate : root.t-rotate + " \{root.rotation-degrees}°";
                    clicked => { root.rotate-preview(); }
                }
                IconPill {
                    icon: @image-url("../../../assets/icons/svg/refresh.svg");
                    has-icon: true;
                    text: root.t-refresh;
                    clicked => { root.refresh-devices(); }
                }
                IconPill {
                    icon: root.recording ? @image-url("../../../assets/icons/svg/player-stop.svg") : @image-url("../../../assets/icons/svg/player-record.svg");
                    has-icon: true;
                    icon-color: #ff453a;
                    text: root.recording ? root.t-record-stop : root.t-record-start;
                    clicked => { root.toggle-record(); }
                }
                IconPill {
                    icon: @image-url("../../../assets/icons/svg/camera.svg");
                    has-icon: true;
                    text: root.t-capture;
                    primary: true;
                    clicked => { root.capture(); }
                }
            }
        }

        HorizontalLayout {
            y: 56px;
            height: parent.height - 80px;
            // Pages sidebar
            Rectangle {
                width: 240px;
                background: Theme.panel;
                Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.border; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: root.t-pages; color: Theme.muted; font-size: 12px; font-weight: 600; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.page-count-text; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    }
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            spacing: 8px;
                            for page[index] in root.pages : Rectangle {
                                height: 84px;
                                border-radius: 8px;
                                background: root.selected-page == index ? Theme.accent.with-alpha(0.16) : (page-touch.has-hover ? Theme.hover : transparent);
                                border-width: 0px;
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 6px;
                                        clip: true;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: #0000001a;
                                        drop-shadow-offset-y: 1px;
                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: page.thumb;
                                            image-fit: contain;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: root.t-page-prefix + "\{page.seq}" + root.t-page-suffix;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: page.title;
                                            color: Theme.muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                }
                                page-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    double-clicked => {
                                        root.selected-page = index;
                                        root.page-selected(index);
                                        root.open-page(index);
                                    }
                                    clicked => {
                                        root.selected-page = index;
                                        root.page-selected(index);
                                    }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                            root.selected-page = index;
                                            root.page-selected(index);
                                            root.page-menu(index);
                                            return EventResult.accept;
                                        }
                                        EventResult.reject
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                background: Theme.dark ? #111113 : #d9d9de;
                Image {
                    source: root.preview-source;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }
                if (!root.has-camera) : Rectangle {
                    background: Theme.dark ? #111113 : #d9d9de;
                    Text {
                        text: root.t-waiting;
                        color: Theme.muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #ffffff;
                    opacity: root.flash ? 0.9 : 0.0;
                    animate opacity { duration: 180ms; easing: ease-out; }
                }
                if (root.show-toast) : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 58px;
                    width: 210px;
                    height: 36px;
                    border-radius: 18px;
                    background: #000000a6;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.toast-text;
                        color: #ffffff;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Settings sidebar
            Rectangle {
                width: 340px;
                background: Theme.panel;
                Rectangle { x: 0px; width: 1px; height: 100%; background: Theme.border; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Section {
                        title: root.t-scan-settings;
                            content-height: 302px;
                            VerticalLayout {
                                padding: 12px;
                                padding-top: 34px;
                                spacing: 7px;
                                FieldLabel { text: root.t-output-dir; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text: root.output-dir;
                                        edited(text) => { root.output-dir = text; }
                                        horizontal-stretch: 1;
                                    }
                                    PillButton { text: root.t-browse; width: 96px; clicked => { root.browse-output(); } }
                                }
                                FieldLabel { text: root.t-file-template; }
                                LineEdit { text: root.file-template; edited(text) => { root.file-template = text; } }
                                FieldLabel { text: root.t-folder-template; }
                                LineEdit { text: root.folder-template; edited(text) => { root.folder-template = text; } }
                                PillButton { text: root.t-apply-settings; primary: true; width: 160px; clicked => { root.apply-settings(); } }
                                HorizontalLayout {
                                    spacing: 6px;
                                    PillButton { text: root.t-import-images; horizontal-stretch: 1; clicked => { root.import-images(); } }
                                    PillButton { text: root.t-export-pdf; horizontal-stretch: 1; clicked => { root.export-pdf(); } }
                                }
                                PillButton {
                                    text: root.update-checking ? root.t-checking-updates : root.t-check-updates;
                                    enabled: !root.update-checking;
                                    horizontal-stretch: 1;
                                    clicked => { root.check-updates(); }
                                }
                            }
                        }

                        Section {
                            title: root.t-enhance;
                            content-height: 214px;
                            VerticalLayout {
                                padding: 12px;
                                padding-top: 34px;
                                spacing: 5px;
                                ToggleRow { label: root.t-auto-crop; checked <=> root.auto-crop; }
                                ToggleRow { label: root.t-auto-deskew; checked <=> root.auto-deskew; }
                                ToggleRow { label: root.t-perspective; checked <=> root.perspective; }
                                ToggleRow { label: root.t-remove-shadow; checked <=> root.remove-shadow; }
                                ToggleRow { label: root.t-white-background; checked <=> root.white-background; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    FieldLabel { text: root.t-strength; width: 34px; }
                                    Slider { minimum: 0; maximum: 100; value <=> root.strength; horizontal-stretch: 1; }
                                    Text { text: root.strength; color: Theme.text; width: 28px; horizontal-alignment: right; }
                                }
                            }
                        }
                    }
                }
            }

        // Status bar
        Rectangle {
            y: parent.height - 24px;
            height: 24px;
            background: Theme.panel;
            Rectangle { y: 0px; height: 1px; width: 100%; background: Theme.border; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text { text: root.status-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: root.page-count-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Rectangle {
                    width: root.has-update ? 72px : 46px;
                    height: 100%;
                    border-radius: 4px;
                    background: root.has-update && update-badge-touch.has-hover ? Theme.hover : transparent;

                    HorizontalLayout {
                        padding-left: 3px;
                        padding-right: 3px;
                        spacing: 4px;
                        alignment: center;
                        Text {
                            text: root.version-text;
                            color: root.has-update ? Theme.text : Theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        if (root.has-update) : Rectangle {
                            width: 14px;
                            height: 14px;
                            Image {
                                width: 14px;
                                height: 14px;
                                source: @image-url("../../../assets/icons/svg/alert-triangle.svg");
                                image-fit: contain;
                                colorize: #f5b800;
                            }
                        }
                    }
                    update-badge-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: root.has-update;
                        mouse-cursor: pointer;
                        clicked => { root.show-update-prompt = true; }
                    }
                }
            }
        }
    }

    // Update prompt: shown only after the user clicks the version badge.
    if (root.show-update-prompt && root.has-update) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.show-update-prompt = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 470px;
            height: 220px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        Image {
                            width: 24px;
                            height: 24px;
                            source: @image-url("../../../assets/icons/svg/alert-triangle.svg");
                            image-fit: contain;
                            colorize: #f5b800;
                        }
                    }
                    Text {
                        text: root.t-update-title + " " + root.update-version;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: root.update-text;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton {
                        text: root.t-update-later;
                        width: 90px;
                        clicked => { root.show-update-prompt = false; }
                    }
                    PillButton {
                        text: root.t-update-now;
                        primary: true;
                        width: 120px;
                        clicked => {
                            root.show-update-prompt = false;
                            root.install-update();
                        }
                    }
                }
            }
        }
    }

    // Rename dialog
    if (root.show-rename) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;
        Rectangle {
            width: 430px;
            height: 150px;
            border-radius: 14px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: root.t-rename-title; color: Theme.text; font-size: 15px; font-weight: 600; }
                LineEdit { text: root.rename-text; edited(text) => { root.rename-text = text; } }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: root.t-cancel; width: 80px; clicked => { root.rename-cancel(); } }
                    PillButton {
                        text: root.t-save;
                        primary: true;
                        width: 90px;
                        clicked => { root.rename-confirm(root.rename-text); }
                    }
                }
            }
        }
    }

    // Tesseract installation prompt
    if (root.show-tesseract-prompt) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;

        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: 250px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: root.tesseract-title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: root.tesseract-status;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton {
                        text: root.tesseract-install-label;
                        primary: true;
                        width: 170px;
                        enabled: !root.tesseract-installing;
                        clicked => { root.install-tesseract(); }
                    }
                    PillButton {
                        text: root.t-cancel;
                        width: 90px;
                        enabled: !root.tesseract-installing;
                        clicked => { root.cancel-tesseract(); }
                    }
                }
            }
        }
    }

    // About dialog
    if (root.show-about) : Rectangle {
        background: #00000066;
        width: 100%;
        height: 100%;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 440px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Image {
                        source: @image-url("../../../assets/icons/usbscan_icons/usbscan_64x64.png");
                        width: 56px;
                        height: 56px;
                        image-fit: contain;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "UsbScan"; color: Theme.text; font-size: 20px; font-weight: 600; }
                        Text { text: root.version-text; color: Theme.muted; font-size: 12px; }
                    }
                }
                Text {
                    text: root.t-about;
                    color: Theme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                TouchArea {
                    width: 100%;
                    height: 22px;
                    clicked => { root.open-github(); }
                    Text {
                        text: "https://github.com/Kaiyuan/usbscan";
                        color: Theme.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.t-language;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Dropdown {
                        width: 150px;
                        model: root.language-options;
                        current-index <=> root.language-index;
                        selected(index) => { root.language-changed(index); }
                    }
                }
                ToggleRow {
                    label: root.t-auto-check;
                    checked <=> root.auto-check-updates;
                    toggled(value) => { root.auto-check-changed(value); }
                }
                Text {
                    text: root.t-update-hint;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: root.t-view-github; width: 150px; clicked => { root.open-github(); } }
                    PillButton { text: root.t-close; primary: true; width: 90px; clicked => { root.close-about(); } }
                }
            }
        }
    }

    // 几乎不可见的全屏覆盖层：切换颜色会让软件渲染器重绘整个窗口，
    // 避免 Windows 长时间最小化后恢复时只重绘局部区域而留下白屏。
    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, root.redraw-tick / 255.0);
    }
}
