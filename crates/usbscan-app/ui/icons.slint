// 图标来自 Tabler Icons（MIT），在这里以矢量路径绘制。
//
// 不使用图片 + colorize 的原因是：部分 Linux / UOS 桌面环境（旧版 Mesa、
// llvmpipe、GLES 驱动）上 colorize 需要离屏纹理和 SourceIn 混合，渲染结果
// 可能是空白。直接绘制路径只依赖最基础的填充/描边能力，在所有后端上一致，
// 并且任意 DPI 下都保持锐利。
//
// `commands` 就是 SVG 里 <path d="..."> 的内容（去掉透明占位矩形）。

export enum IconName {
    empty,
    adjust,
    alert,
    camera,
    chevron,
    contrast,
    crop,
    file-text,
    folder,
    folders,
    perspective,
    refresh,
    rotate,
    settings,
    shadow-off,
    stop,
    video,
    wand,
}

// Tabler 图标在 24×24 的坐标系里用 2px 圆头描边。
component StrokeIcon inherits Path {
    in property <length> icon-size: 16px;
    in property <brush> icon-color: black;

    width: 100%;
    height: 100%;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: icon-color;
    stroke-width: icon-size * 0.0834;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component Icon inherits Rectangle {
    in property <IconName> name: IconName.empty;
    in property <length> icon-size: 16px;
    in property <brush> icon-color: black;

    width: icon-size;
    height: icon-size;
    background: transparent;

    if (name == IconName.adjust) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M4 6l16 0 M4 12l16 0 M4 18l16 0 M8 4l0 4 M16 10l0 4 M8 16l0 4";
    }
    if (name == IconName.alert) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M12 9v4 M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z M12 16h.01";
    }
    if (name == IconName.camera) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2 M9 13a3 3 0 1 0 6 0a3 3 0 0 0 -6 0";
    }
    if (name == IconName.chevron) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M6 9l6 6l6 -6";
    }
    if (name == IconName.contrast) : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        StrokeIcon {
            icon-size: root.icon-size;
            icon-color: root.icon-color;
            commands: "M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0";
        }
        // Tabler 的实心半圆
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: root.icon-color;
            stroke-width: 0px;
            commands: "M12 3a9 9 0 0 1 0 18z";
        }
    }
    if (name == IconName.crop) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M8 5v10a1 1 0 0 0 1 1h10 M5 8h10a1 1 0 0 1 1 1v10";
    }
    if (name == IconName.file-text) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M14 3v4a1 1 0 0 0 1 1h4 M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z M9 9l1 0 M9 13l6 0 M9 17l6 0";
    }
    if (name == IconName.folder) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2";
    }
    if (name == IconName.folders) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M9 3h3l3 3h6a2 2 0 0 1 2 2v7a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2 M3 7v11a2 2 0 0 0 2 2h13";
    }
    if (name == IconName.perspective) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M6 5h12l2 14h-16z M9 9h6 M8 15h8";
    }
    if (name == IconName.refresh) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4";
    }
    if (name == IconName.rotate) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M4.05 11a8 8 0 1 1 .5 4m-.5 5v-5h5";
    }
    if (name == IconName.settings) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065 M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0";
    }
    if (name == IconName.shadow-off) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M3 3l18 18 M11 5h1a6 6 0 0 1 6 6v1 M7 11a6 6 0 0 0 6 6h1";
    }
    if (name == IconName.stop) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M5 7a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2l0 -10";
    }
    if (name == IconName.video) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M15 10l4.553 -2.276a1 1 0 0 1 1.447 .894v6.764a1 1 0 0 1 -1.447 .894l-4.553 -2.276v-4z M3 6m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z";
    }
    if (name == IconName.wand) : StrokeIcon {
        icon-size: root.icon-size;
        icon-color: root.icon-color;
        commands: "M6 21l15 -15l-3 -3l-15 15l3 3 M15 6l3 3 M9 3l.5 2l2 .5l-2 .5l-.5 2l-.5 -2l-2 -.5l2 -.5z M19 13l.5 2l2 .5l-2 .5l-.5 2l-.5 -2l-2 -.5l2 -.5z";
    }
}
